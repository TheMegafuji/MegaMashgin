# Local synthetic checkout. Jev is optional; ordinary search and checkout work without a key.
DATABASE_URL=postgresql://checkout:local-demo-only@127.0.0.1:55542/checkout
TEST_DATABASE_URL=postgresql://checkout:local-test-only@127.0.0.1:55543/checkout_test
PORT=3190
HOST=127.0.0.1
PUBLIC_ORIGIN=http://localhost:5190
# Explicit token-only browser origins for MarketTycoon; keep this list closed.
GAME_ORIGINS=http://localhost:5180,http://127.0.0.1:5180
# Bounded game-origin session admission per IP per 10 minutes; ordinary checkout remains 30.
GAME_SESSIONS_LIMIT=15000
GAME_SESSIONS_GLOBAL_LIMIT=15000
# Bounded explicit game orders per rolling minute; ordinary checkout remains 300/minute.
GAME_ORDERS_LIMIT=1800
INSTANCE_ID=api-local
LOG_LEVEL=info

# Server-only optional semantic search. Never use a VITE_ prefix.
TYPESAFE_API_KEY=
TYPESAFE_MAX_CALLS_PER_DAY=100
TYPESAFE_TIMEOUT_MS=4000
